		"hang": 1.2,
		"hang_len": 9,
		# Как охотно кончик решается свеситься. Умножается на ВОЛЬНОСТЬ ветви
		# (`free_k`, от нуля до единицы), поэтому в среднем выходит вдвое реже
		# написанного: плети идут от вольных ветвей, а не от всякой.
		"hang_rate": 0.25,
		"hang_sway": 0.25,
		# СКОЛЬКО ЗВЕНЬЕВ ВОЛЬНАЯ ВЕТВЬ ДОЛЖНА ПРОЛЕТЕТЬ, ПРЕЖДЕ ЧЕМ ПОВИСНУТЬ.
		# Это второй путь к плети, и в нынешнем мире — единственный работающий:
		# кромок, годных для свисания, тут 17 на 2000 мест, а лиана к ним и не
		# идёт, потому что лезет вверх.
		#
		# РАВНО `air_max`, то есть виснет та ветвь, что своё уже отлетала, — и
		# уменьшать это число НЕ НАДО, хоть и кажется, что так плетей станет
		# больше. Замерено на двойке: плеть заводится в двух звеньях от камня,
		# сразу упирается в землю, и места ей не хватило НИ РАЗУ (24 попытки за
		# кромку, ноль плетей против двух).
		"hang_air": 4,
		"surfaces": ["side", "top"],
		"thickness": 0.05,
	},
