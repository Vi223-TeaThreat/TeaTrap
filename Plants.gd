extends RefCounted
# =============================================================================
#  КАТАЛОГ ВСЕГО, ЧТО МОЖНО СТАВИТЬ — это ДАННЫЕ, а не код.
#
#  Три класса, у каждого своя природа:
#    surface — ПОВЕРХНОСТЬ: порода, из которой сложен мир. Занимает ячейку
#              целиком, сливается с соседями в общую оболочку.
#    plant   — РАСТЕНИЯ: живут на кусочке поверхности, растут и расползаются.
#    prop    — ОБЪЕКТЫ: отдельные предметы на поверхности — камни, коряги,
#              обломки, постройки. Не растут и не сливаются, но влияют на
#              соседей: дают тень и создают стыки, у которых любит селиться мох.
#
#  Чтобы добавить новое, достаточно дописать сюда карточку.
#
#  Ярусы растительности повторяют настоящие:
#    1 — верхний (самые высокие), 2 — средний (кустарники),
#    3 — нижний (травы и многолетники), 4 — лишайники и мхи.
# =============================================================================

# Панель складывается в три пункта. Ярусы растительности живут внутри одного
# из них, чтобы список не расползался на весь экран.
const GROUPS := [
	{"key": 1, "name": "Поверхность", "tiers": [0]},
	{"key": 2, "name": "Растения", "tiers": [1, 2, 6, 3, 4]},
	{"key": 3, "name": "Объекты", "tiers": [5]},
]

const TIERS := [
	{"key": 0, "name": "Поверхность", "hint": "порода"},
	{"key": 1, "name": "Верхний ярус", "hint": "самые высокие"},
	{"key": 2, "name": "Средний ярус", "hint": "кустарники"},
	{"key": 3, "name": "Нижний ярус", "hint": "травы и многолетники"},
	{"key": 4, "name": "Лишайники и мхи", "hint": ""},
	{"key": 5, "name": "Объекты", "hint": "камни, коряги, постройки"},
	# Лианы — не ярус по высоте, а форма роста: они пронизывают все ярусы.
	{"key": 6, "name": "Лианы", "hint": "вьющиеся"},
]

# Поля карточки растения:
#   grow_rate   — прирост зрелости в секунду (фоновый рост)
#   spread_at   — с какой зрелости растение даёт отростки
#   spread_rate — сколько попыток расползания в секунду
#   shade_love  — насколько лучше растёт в тени
#   joint_love  — насколько лучше растёт на стыках и у подножий
#   thickness   — толщина кочки при полной зрелости
#
# Поля карточки объекта:
#   shape       — какую заглушку рисовать: rock / debris / snag / hut
#   size        — размер относительно кусочка поверхности
#   shade       — сколько тени даёт соседям
#   upright     — 0 стоит по нормали поверхности, 1 всегда вертикально
const ITEMS := {
	# --- Поверхность. Занимает ячейку и участвует в оболочке мира.
	#   hold  — насколько грани сопротивляются сглаживанию (0 оплывает, 1 остра)
	#   stone — из чего сложено: 0 земля (дёрн, мягкий склон),
	#           1 скала (голая слоистая порода, зарастает только сверху)
	#   built — на ячейке вырастает постройка
	"ground": {
		"kind": "surface",
		"name": "Земля",
		"tier": 0,
		"color": Color(0.34, 0.48, 0.22),
		"hold": 0.0,
		"stone": 0.0,
	},
	# Скала НЕ замещает ячейку целиком: поверхность мира идёт сквозь неё и
	# остаётся гладкой (потому жёсткость низкая), а угловатость дают плиты,
	# которые ставит `SpaceRocks.gd`.
	"cliff": {
		"kind": "surface",
		"name": "Скала",
		"tier": 0,
		"color": Color(0.29, 0.26, 0.24),
		"hold": 0.20,
		"stone": 1.0,
	},
	"building": {
		"kind": "surface",
		"name": "Здание",
		"tier": 0,
		"color": Color(0.23, 0.22, 0.19),
		"hold": 0.25,
		"stone": 0.5,
		"built": true,
	},
	# Мох намеренно ЯРЧЕ и ЖЕЛТЕЕ дёрна: иначе кочки растворятся в склоне.
	# На снимках так и есть — подушки мха светятся на фоне тёмной зелени.
	"moss": {
		"kind": "plant",
		"name": "Мох",
		"tier": 4,
		"color": Color(0.34, 0.43, 0.15),
		"grow_rate": 0.09,
		"spread_at": 0.45,
		"spread_rate": 0.16,
		"shade_love": 0.8,
		"joint_love": 1.2,
		"surfaces": ["ground", "top", "side"],
		"thickness": 0.07,
	},
	# Лиана — не ковёр, а НАПРАВЛЕННЫЙ побег. Тот же механизм расползания, что
	# у мха, но с сильным перевесом вверх (`climb`): из ковра он превращается
	# в плеть. Дойдя до кромки, лиана переваливается и свисает (`hang`).
	# У опоры — камня, коряги, стены — идёт бодрее (`support_love`).
	"vine": {
		"kind": "plant",
		"name": "Лиана",
		"tier": 6,
		"shape": "vine",
		"color": Color(0.27, 0.40, 0.16),
		"grow_rate": 0.07,
		"spread_at": 0.30,
		"spread_rate": 0.26,
		"shade_love": 0.5,
		"joint_love": 0.7,
		"climb": 1.6,
		"hang": 1.2,
		"support_love": 1.4,
		"surfaces": ["side", "top"],
		"thickness": 0.05,
	},
	"rock": {
		"kind": "prop",
		"name": "Валун",
		"tier": 5,
		"shape": "rock",
		"color": Color(0.46, 0.45, 0.43),
		"size": 1.15,
		"shade": 0.5,
		"upright": 0.25,
	},
	"debris": {
		"kind": "prop",
		"name": "Обломки",
		"tier": 5,
		"shape": "debris",
		"color": Color(0.56, 0.53, 0.48),
		"size": 1.0,
		"shade": 0.25,
		"upright": 0.0,
	},
	"snag": {
		"kind": "prop",
		"name": "Коряга",
		"tier": 5,
		"shape": "snag",
		"color": Color(0.40, 0.33, 0.26),
		"size": 1.3,
		"shade": 0.45,
		"upright": 0.7,
	},
}


static func is_surface(id: String) -> bool:
	return kind_of(id) == "surface"


static func tier_info(tier: int) -> Dictionary:
	for t in TIERS:
		if int(t["key"]) == tier:
			return t
	return {"key": tier, "name": "", "hint": ""}


static func of_tier(tier: int) -> Array:
	var out: Array = []
	for id in ITEMS:
		if int(ITEMS[id]["tier"]) == tier:
			out.append(id)
	return out


static func kind_of(id: String) -> String:
	return ITEMS[id]["kind"] if ITEMS.has(id) else ""


static func is_plant(id: String) -> bool:
	return kind_of(id) == "plant"


static func is_prop(id: String) -> bool:
	return kind_of(id) == "prop"
