static func tier_info(tier: int) -> Dictionary:
	for t in TIERS:
		if int(t["key"]) == tier:
			return t
	return {"key": tier, "name": "", "hint": ""}


static func of_tier(tier: int) -> Array:
	var out: Array = []
	for id in ITEMS:
		if int(ITEMS[id]["tier"]) == tier:
			out.append(id)
	return out


static func kind_of(id: String) -> String:
	return ITEMS[id]["kind"] if ITEMS.has(id) else ""


static func is_plant(id: String) -> bool:
	return kind_of(id) == "plant"


static func is_prop(id: String) -> bool:
	return kind_of(id) == "prop"
