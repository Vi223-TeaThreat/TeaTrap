# =============================================================================
#  ВСТРЕЧИ ВИДОВ: ЧТО РОДИТСЯ ТАМ, ГДЕ ДВОЕ СОШЛИСЬ ВПЛОТНУЮ
# =============================================================================
#
# Первая трансформация в игре (решение пользователя 2026-08-29): лоза доползла до
# кочки мха — и на стыке заводится ТРЕТИЙ вид, которого больше взяться неоткуда.
#
# ЭТО ДАННЫЕ, А НЕ КОД. Встреч со временем будет несколько, и различает их только
# эта таблица: кто с кем, что из этого выходит, как охотно и как часто. Правило
# ДВУСТОРОННЕЕ — всё равно, лоза ли доросла до мха или мох подполз под лозу.
#
# Поля:
#   who   — двое, чья встреча считается; порядок неважен
#   born  — что рождается на стыке
#   touch — какой зазор ещё считается касанием, в метрах. Меряется от края тела
#           кочки (её радиус в этот миг) до точки звена: нить тонкая, своего
#           радиуса у неё почти нет, и весь запас держится здесь.
#   ripe  — насколько взрослой должна быть КОЧКА. У нити зрелость значит толщину
#           звена, а не размер пятна, поэтому к ней эта мерка не применяется
#           вовсе: новорождённое звено — такое же звено.
#   rate  — доля касаний, из которых выходит рождение. Редкость держит не оно, а
#           `apart` ниже; этому же числу оставлено только одно дело — чтобы
#           пятно заводилось не строго у первого коснувшегося звена. Слишком
#           малым его брать нельзя: замерено при 0.3 — шесть касаний за прогон
#           и НИ ОДНОГО рождения, то есть первая встреча в игре может и не
#           случиться на глазах.
#   apart — и главное: НЕ БЛИЖЕ СКОЛЬКИХ ЯЧЕЕК ОТ УЖЕ РОДИВШЕГОСЯ. Без этого
#           числа встреча — не событие, а покрытие: лоза, идущая по ковру, даёт
#           касание на каждом своём звене (звено — 10 см), и стык оброс бы
#           сплошной каймой из третьего вида. С ним же на стыке появляется одно
#           пятно, а дальше оно расползается само.
const MEETS := [
	{
		"who": ["vine", "moss"],
		"born": "liamoss",
		"touch": 0.05,
		"ripe": 0.55,
		"rate": 0.6,
		"apart": 1.8,
	},
]


static func tier_info(tier: int) -> Dictionary:
	for t in TIERS:
		if int(t["key"]) == tier:
			return t
	return {"key": tier, "name": "", "hint": ""}


# ЧТО ПОКАЗЫВАТЬ В ПАНЕЛИ на этом ярусе. Рождающееся на стыке (`born_only`) сюда
# не попадает: рукой его не сажают, и в списке ставимого ему делать нечего.
static func of_tier(tier: int) -> Array:
	var out: Array = []
	for id in ITEMS:
		if int(ITEMS[id]["tier"]) == tier and not bool(ITEMS[id].get("born_only", false)):
			out.append(id)
	return out


static func kind_of(id: String) -> String:
	return ITEMS[id]["kind"] if ITEMS.has(id) else ""


static func is_plant(id: String) -> bool:
	return kind_of(id) == "plant"


static func is_prop(id: String) -> bool:
	return kind_of(id) == "prop"


static func is_care(id: String) -> bool:
	return kind_of(id) == "care"
