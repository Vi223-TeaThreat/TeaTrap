shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, depth_test_disabled, cull_disabled;

// =============================================================================
//  МЕТКА НАХОДКИ — ГДЕ ИМЕННО ЭТО СЛУЧИЛОСЬ
// =============================================================================
//
//  Решение пользователя 2026-10-02: «когда выполняются условия задания, нужно на
//  местности показать, где конкретно это произошло… временная обводка или
//  указатель места появления лиамоха».
//
//  Метка о двух частях, и каждая делает своё:
//    * пятно по земле (`Cursor.gdshader`, тёплый тон) — ТОЧНОЕ МЕСТО. Оно лежит
//      по форме земли и не спорит с рельефом, но в густых зарослях его не видно;
//    * этот огонёк — ЧТОБЫ НАЙТИ. Он висит над зарослями и всегда повёрнут лицом
//      к камере, поэтому читается и с высоты, и сбоку.
//
//  РИСУЕТСЯ ПОВЕРХ ВСЕГО (`depth_test_disabled`) — нарочно. Подсказка, которую
//  закрывает лист, подсказкой не работает; это тот же случай, что и значок в
//  углу, только стоящий на своём месте в мире.
//
//  Картинки у метки нет: кольцо и ядро считаются по расстоянию от середины
//  квада. Так ей не нужен ни файл, ни место в листе, и она одинаково чиста на
//  любом удалении.

uniform vec3 tone : source_color = vec3(1.0, 0.86, 0.42);
uniform float size = 0.5;        // поперечник метки в метрах
uniform float fade = 1.0;        // общая сила: по ней метка и гаснет

void vertex() {
	// БИЛБОРД: квад всегда лицом к камере. Повороты узла при этом теряются —
	// значит, и размер держим здесь, своим числом в метрах.
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(
		vec4(normalize(INV_VIEW_MATRIX[0].xyz), 0.0),
		vec4(normalize(INV_VIEW_MATRIX[1].xyz), 0.0),
		vec4(normalize(INV_VIEW_MATRIX[2].xyz), 0.0),
		MODEL_MATRIX[3]);
	VERTEX *= size;
}

void fragment() {
	float d = length(UV * 2.0 - 1.0);
	// Кольцо с мягкими краями и светлое ядро под ним: кольцо показывает место,
	// ядро не даёт метке потеряться на светлом фоне.
	float ring = smoothstep(0.46, 0.66, d) * (1.0 - smoothstep(0.74, 0.96, d));
	float core = 1.0 - smoothstep(0.0, 0.30, d);
	// ДЫХАНИЕ, А НЕ МИГАНИЕ. Метка живая, но спокойная: резкое мигание в
	// медленной игре читается тревогой.
	float breath = 0.80 + 0.20 * sin(TIME * 2.2);
	float glow = (ring + core * 0.6) * breath * fade;
	if (glow <= 0.004) {
		discard;
	}
	ALBEDO = tone * glow;
	ALPHA = clamp(glow, 0.0, 1.0);
}
