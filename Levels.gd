static func index_of(id: String) -> int:
	for i in range(LEVELS.size()):
		if String(LEVELS[i]["id"]) == id:
			return i
	return -1


static func find(id: String) -> Dictionary:
	var i: int = index_of(id)
	return LEVELS[i] if i >= 0 else {}
