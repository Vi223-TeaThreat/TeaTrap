shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_back;

// =============================================================================
//  ПОДСВЕТКА ТОГО МЕСТА, КУДА УКАЗЫВАЕТ КУРСОР.
//
//  Рисуем копию самой поверхности вокруг прицела, чуть приподнятую над ней, и
//  гасим её к краям по расстоянию от точки прицела. Получается светлое пятно,
//  лежащее ровно по форме земли: на бугре оно выгибается, в ложбине проседает.
//
//  Кольцо и шар этого не давали: на крутом месте кольцо видно с ребра, а шар
//  висел отдельным телом и спорил с рельефом.
// =============================================================================

uniform vec3 spot;                       // куда указывает курсор
uniform float reach = 1.0;               // до какого расстояния светится
uniform vec3 tone : source_color = vec3(0.42, 0.72, 0.34);
uniform float strength = 0.55;

varying vec3 w_pos;

void vertex() {
	// Приподнимаем над землёй, иначе накладка спорит с ней за пиксели.
	// Приподнимаем чуть-чуть: в глубокой выемке накладка с большим подъёмом
	// сама себя протыкает и торчит из ямы угловатыми лоскутами.
	VERTEX += NORMAL * 0.004;
	w_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	float d = distance(w_pos, spot) / max(reach, 0.001);
	// Ярче к середине, к краю сходит на нет — границы у пятна нет.
	float glow = 1.0 - smoothstep(0.25, 1.0, d);
	if (glow <= 0.003) {
		discard;
	}
	ALBEDO = tone * (glow * strength);
	ALPHA = glow;
}
