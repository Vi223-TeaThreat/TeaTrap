# Служебная папка Godot: кэш импорта и настройки редактора, каждый раз разные.
.godot/

# Экспортированные сборки.
build/
*.exe
*.pck

# Кроме браузерной демки: она и есть то, что раздаётся друзьям по ссылке,
# поэтому её собранные файлы должны лежать в репозитории.
!docs/**

# Рабочие листы генератора текстур: варианты на выбор и шаг отмены. Каждый
# запуск разные, в игру не идут. Заморозка руки (moss_hand.png) и рецепты
# (recipes.json) — наоборот, в репозитории.
art/pick.png
art/pick_ages.png
art/moss_prev.png
art/pick_all.png
art/pick_all_zoom.png
art/pick.png.import
art/pick_ages.png.import
art/moss_prev.png.import
