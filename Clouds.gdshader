shader_type spatial;
render_mode unshaded, cull_disabled;

// =============================================================================
//  ТЕНИ ОБЛАКОВ (погода «облака», 15.09.2026).
//
//  Облаков на небе нет — её выбор, — а тени их по земле бегут. Тень даёт не
//  краска, а СОЛНЦЕ: над островом висит плоскость, которую камера не видит, а
//  солнце видит (`SHADOWS_ONLY` в `Weather.gd`). Прорези в ней — просветы между
//  облаками. Отсюда три вещи сразу и даром:
//
//    • тень ложится на всё, что видит солнце, — на землю, камень, мох, лозу, мак,
//      и ни один шейдер для этого не правился;
//    • гасится только прямой свет: там, где и так тень, облако не темнит ничего;
//    • работает и в браузерной сборке — тени у неё есть.
//
//  Край мягкий от размера светила (`light_angular_distance`): плоскость в двадцати
//  с лишним метрах над землёй, и доля градуса даёт переход в пару десятков
//  сантиметров. В браузере мягкого края нет — там тени резкие.
//
//  УЗОР ТОТ ЖЕ, ЧТО В `Weather.gd` (`cloud_field`): по его копии на процессоре
//  подобран порог (`cut`), при котором в тени заказанная доля земли.
// =============================================================================

uniform float cloud_time = 0.0;
uniform float cut = 2.0;                             // выше единицы — ни одного облака
uniform vec2 drift = vec2(1.12, 0.84);               // ветер, м/с
uniform float cloud_size = 18.0;                     // крупность узора, м

varying vec2 w_xz;

float hash12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

float vnoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(hash12(i), hash12(i + vec2(1.0, 0.0)), f.x),
		mix(hash12(i + vec2(0.0, 1.0)), hash12(i + vec2(1.0, 1.0)), f.x), f.y);
}

float cloud_field(vec2 p) {
	return vnoise(p) * 0.6 + vnoise(p * 2.03 + 17.0) * 0.28 + vnoise(p * 4.11 + 41.0) * 0.12;
}

void vertex() {
	w_xz = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xz;
}

void fragment() {
	if (cloud_field((w_xz - drift * cloud_time) / cloud_size) < cut) {
		discard;
	}
	ALBEDO = vec3(1.0);
}
