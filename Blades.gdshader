shader_type spatial;
render_mode cull_disabled, diffuse_lambert, specular_disabled;

// =============================================================================
//  ЗЕЛЕНЬ НА ДОЩЕЧКАХ.
//
//  Кочка набрана из плоских картинок, поставленных под разными углами. Готовый
//  материал для такого не годится по двум причинам, и обе видны на кадрах.
//
//  1) ИЗНАНКА ТЕМНЕЛА. Дощечка видна с обеих сторон, а встроенный материал
//     переворачивает нормаль у обратной стороны — и половина квадратов в пучке
//     оказывалась освещена снизу, то есть почти чёрной. Здесь нормаль задаётся
//     прямо и от стороны не зависит: у листа нет изнанки.
//
//  2) СВЕТ БЫЛ ЖЁСТКИМ. Зелень просвечивает: на солнце светится, в тени не
//     проваливается в черноту. Свет заворачиваем за край (`wrap`) — граница
//     света и тени размывается, как на рисованных задниках.
//
//  Нормаль всем дощечкам пучка даём ОДНУ — от земли под ним. Своя у стоячей
//  дощечки смотрит вбок, и кочка на солнечном склоне выходила бы тёмной.
// =============================================================================

uniform sampler2D blades : source_color, filter_nearest, repeat_disable;
uniform float cutoff = 0.5;
uniform float wrap : hint_range(0.0, 1.0) = 0.55;
// Чем зелень отзывается на свет сзади — просвет листа.
uniform vec3 glow : source_color = vec3(0.20, 0.30, 0.13);
// Тень у зелени не серая, а холодная и зеленоватая.
uniform vec3 shade_tint : source_color = vec3(0.42, 0.52, 0.44);

varying vec3 v_nrm;

void vertex() {
	v_nrm = normalize((MODELVIEW_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec4 c = texture(blades, UV);
	if (c.a < cutoff) {
		discard;
	}
	ALBEDO = c.rgb * COLOR.rgb;
	NORMAL = v_nrm;                  // одна и та же с обеих сторон
	ROUGHNESS = 1.0;
}

void light() {
	float d = dot(normalize(NORMAL), normalize(LIGHT));
	// Обёрнутый свет: ноль не там, где луч скользит по поверхности, а заметно
	// дальше. Оттого нет резкой линии терминатора.
	float lit = clamp((d + wrap) / (1.0 + wrap), 0.0, 1.0);
	// Просвет: то, что светит сзади, частью проходит насквозь.
	float back = clamp(-d, 0.0, 1.0);
	vec3 tone = mix(ALBEDO * shade_tint, ALBEDO, lit);
	DIFFUSE_LIGHT += (tone * lit + ALBEDO * glow * back) * LIGHT_COLOR * ATTENUATION;
}
