shader_type spatial;
render_mode cull_disabled, diffuse_lambert, specular_disabled;

// =============================================================================
//  ЗЕЛЕНЬ НА ДОЩЕЧКАХ.
//
//  Кочка набрана из плоских картинок, поставленных под разными углами. Готовый
//  материал для такого не годится по двум причинам, и обе видны на кадрах.
//
//  1) ИЗНАНКА ТЕМНЕЛА. Дощечка видна с обеих сторон, а встроенный материал
//     переворачивает нормаль у обратной стороны — и половина квадратов в пучке
//     оказывалась освещена снизу, то есть почти чёрной. Здесь нормаль задаётся
//     прямо и от стороны не зависит: у листа нет изнанки.
//
//  2) СВЕТ БЫЛ ЖЁСТКИМ. Зелень просвечивает: на солнце светится, в тени не
//     проваливается в черноту. Свет заворачиваем за край (`wrap`) — граница
//     света и тени размывается, как на рисованных задниках.
//
//  Нормаль всем дощечкам пучка даём ОДНУ — от земли под ним. Своя у стоячей
//  дощечки смотрит вбок, и кочка на солнечном склоне выходила бы тёмной.
//
//  РЕЛЬЕФ ТЕЛА. Купол кочки гладкий, а холмики на нём НАРИСОВАНЫ светом и тенью
//  — оттого они одинаковы со всех сторон и при любом солнце, и вблизи тело
//  читается наклейкой, натянутой на купол. Карта нормалей делает нарисованное
//  настоящим: свет ложится по холмикам сам, макушка ловит солнце, стык уходит в
//  тень, и при повороте камеры рисунок отзывается. Треугольников на это не
//  уходит ни одного.
//
//  РАМУ ПОПЕРЁК ПОВЕРХНОСТИ СЧИТАЕМ НА МЕСТЕ, из производных положения и
//  разметки, а не берём с меша. У меша её нет, и добывалась бы она пересчётом
//  при каждой пересборке — а кочка пересобирается на каждой из девяти ступеней
//  роста, кочек сотни. Здесь же это несколько действий на точку кадра.
// =============================================================================

uniform sampler2D blades : source_color, filter_nearest, repeat_disable;
// Карту нормалей читаем БЕЗ `source_color`: в ней не цвет, а направления, и
// перевод из гаммы в линейное их бы перекосил. Ближней точкой, как и цвет: у
// пиксельного мха рельеф обязан ложиться теми же квадратами, что и зелень, —
// иначе свет размазывает то, что цвет держит острым.
uniform sampler2D bumps : filter_nearest, repeat_disable;
uniform float bump : hint_range(0.0, 2.0) = 1.0;
uniform float cutoff = 0.5;
// Клетка образца на листе. Тело носит её С ЗАВОРОТОМ: разметка приходит в долях
// образца и за клетку выходит, а завернуть её надо ЗДЕСЬ, на точке кадра.
// Заворачивать по вершинам нельзя — их у кочки полсотни, и на переходе через
// край картинку прогоняло бы задом наперёд через весь треугольник.
uniform vec2 body_cell = vec2(0.2, 0.111111);
uniform float wrap : hint_range(0.0, 1.0) = 0.55;
// Чем зелень отзывается на свет сзади — просвет листа.
uniform vec3 glow : source_color = vec3(0.20, 0.30, 0.13);
// Тень у зелени не серая, а холодная и зеленоватая.
uniform vec3 shade_tint : source_color = vec3(0.42, 0.52, 0.44);

varying vec3 v_nrm;

void vertex() {
	v_nrm = normalize((MODELVIEW_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

// ЦВЕТ ВЕРШИН И ВЕБ-СБОРКА. Цвет кладётся в меш переведённым в линейное
// пространство (`srgb_to_linear` на стороне кода) — настольному рендереру так
// и надо, он на выводе кодирует обратно. Рендерер веб-сборки (Compatibility)
// обратно НЕ кодирует, и тёмный цвет уходил на экран «в квадрате»: кора лозы
// и коробочки мха были чёрными. `OUTPUT_IS_SRGB` отличает его честно, а эта
// функция возвращает цвету исходную гамму.
vec3 vertex_tint(vec3 c) {
	if (OUTPUT_IS_SRGB) {
		return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055,
			step(vec3(0.0031308), c));
	}
	return c;
}

void fragment() {
	// Отрицательная вторая разметка — знак, что заворачивать нечего: ворсинка
	// берёт вырезанную фигурку целиком, а не повторяющийся образец, как тело.
	vec2 uv = UV;
	if (UV2.x >= 0.0) {
		uv = UV2 + fract(UV) * body_cell;
	}
	vec4 c = texture(blades, uv);
	if (c.a < cutoff) {
		discard;
	}
	ALBEDO = c.rgb * vertex_tint(COLOR.rgb);
	vec3 n = normalize(v_nrm);       // одна и та же с обеих сторон
	if (bump > 0.0) {
		// Рама поперёк поверхности: куда по ней идёт «вправо» и «вниз» по
		// разметке. `VERTEX` в этом месте — положение точки у глаза, и рама
		// выходит в тех же осях, в каких лежит нормаль.
		vec3 dpx = dFdx(VERTEX);
		vec3 dpy = dFdy(VERTEX);
		vec2 dux = dFdx(UV);
		vec2 duy = dFdy(UV);
		vec3 perp_x = cross(dpy, n);
		vec3 perp_y = cross(n, dpx);
		vec3 axis_u = perp_x * dux.x + perp_y * duy.x;
		vec3 axis_v = perp_x * dux.y + perp_y * duy.y;
		// Обе оси меряем одной меркой — по длинной. Разной кочку косит там, где
		// разметка растянута: у обода она вдвое гуще, чем на макушке.
		float even = inversesqrt(max(max(dot(axis_u, axis_u),
			dot(axis_v, axis_v)), 1e-12));
		// Раму строим по НЕЗАВЁРНУТОЙ разметке: у неё нет разрыва на краю
		// клетки, а направление и мерка у обеих одни и те же.
		vec3 relief = texture(bumps, uv).xyz * 2.0 - 1.0;
		// Наклоняем нормаль, а не собираем её заново: у пологого рельефа третья
		// доля почти единица, и сложение даёт то же самое, но не рушится там,
		// где производные вырождаются.
		n = normalize(n + (axis_u * relief.x + axis_v * relief.y) * (even * bump));
	}
	NORMAL = n;
	ROUGHNESS = 1.0;
}

void light() {
	float d = dot(normalize(NORMAL), normalize(LIGHT));
	// Обёрнутый свет: ноль не там, где луч скользит по поверхности, а заметно
	// дальше. Оттого нет резкой линии терминатора.
	float lit = clamp((d + wrap) / (1.0 + wrap), 0.0, 1.0);
	// Просвет: то, что светит сзади, частью проходит насквозь.
	float back = clamp(-d, 0.0, 1.0);
	vec3 tone = mix(ALBEDO * shade_tint, ALBEDO, lit);
	DIFFUSE_LIGHT += (tone * lit + ALBEDO * glow * back) * LIGHT_COLOR * ATTENUATION;
}
