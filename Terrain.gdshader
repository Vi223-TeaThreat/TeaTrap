shader_type spatial;
render_mode cull_back, diffuse_burley;

// =============================================================================
//  ОБЛИК ПОРОДЫ.
//
//  Цвет поверхности НЕ задан заранее — он вычисляется на месте, по наклону
//  и высоте. Отсюда сразу три вещи, которые видно на живых скалах:
//
//    1) ЗЕЛЁНЫЙ ПОКРОВ ЛОЖИТСЯ ПО НАКЛОНУ. Пологое зарастает, отвесное
//       остаётся голым. Граница рваная — её ведёт шумом, поэтому зелень
//       переваливает через кромку языками, а не ровной линией.
//    2) ПОРОДА ПЯТНИСТАЯ, без рисунка слоёв: облик скал ещё не выбран,
//       и до нового образца камень остаётся просто тёмным и неровным.
//    3) ЩЕЛИ ТЕМНЕЮТ. Насколько точка сидит во впадине, посчитано заранее
//       и передано в UV — по нему затеняем стыки между глыбами.
//
//  Считается по пикселям, а не по вершинам: границы ячеек не проступают,
//  и перестройка куска не становится дороже ни на миллисекунду.
//
//  Через UV приходит: x — порода (0 земля, 1 скала), y — впадина (0.5 ровно).
// =============================================================================

// Порода НАМНОГО темнее дёрна — на снимках это главный контраст кадра.
// И держим её нейтральной: у тёплого серого небо поднимает синий канал
// сильнее зелёного, и камень уходит в пыльно-розовый.
// Светлый гранит: бело-серый, местами почти белый, с лишайниковой рябью.
// Он нарочно спорит с зеленью — камень должно быть видно издалека.
uniform vec3 rock_dark : source_color = vec3(0.24, 0.24, 0.235);
uniform vec3 rock_light : source_color = vec3(0.53, 0.53, 0.51);
uniform vec3 soil_dark : source_color = vec3(0.19, 0.15, 0.11);
uniform vec3 soil_light : source_color = vec3(0.40, 0.33, 0.24);
// Зелень намеренно оливковая, а не salad: на снимках трава северная,
// приглушённая. Ядовитый зелёный сразу выдаёт компьютерную картинку.
uniform vec3 turf_deep : source_color = vec3(0.10, 0.17, 0.10);
uniform vec3 turf_lit : source_color = vec3(0.35, 0.44, 0.18);
uniform vec3 turf_dry : source_color = vec3(0.50, 0.47, 0.24);

uniform float mantle_soil = 0.42;                    // с какого наклона зарастает земля
uniform float mantle_stone = 1.05;                   // ... и камень (почти никогда)
// ЗЕЛЕНЬ В ТРЕЩИНАХ — решение пользователя: «тени и мох в трещинах».
// Поднято с 0.26: трещина собирает нанос на стенке любой крутизны, а прежняя
// величина пускала зелень только туда, где камень и так почти горизонтален, —
// то есть в трещины не пускала вовсе.
// УБАВЛЕНО ОБРАТНО до 0.30. Поднимал я его до 0.50, когда трещины темнели и
// зелень должна была в них садиться; затенение убрано, а размах остался — и
// вдвое усилил чувствительность зелени к впадине, то есть к величине с вершин.
// Вместе с узкой полосой перехода это и дало треугольные пятна на камне.
uniform float moss_crack = 0.30;                     // зелень копится в трещинах
uniform float moss_damp = 0.40;                      // местами глыба зарастает
uniform float mantle_rough = 0.45;                   // рваность края зелени
uniform float bald = 0.32;                           // проплешины голой земли
uniform float cavity_dark : hint_range(0.0, 1.0) = 1.0;
uniform float posterize = 20.0;                      // ступеней тона; 0 — выключить
// РАЗВОДЫ ПО КАМНЮ. `rock_swirl` — насколько уводится координата, из которой
// берётся рисунок (0 — круглые кляксы, больше — текучие жилы); `rock_veins` —
// насколько сильно жилы правят тон. См. «РАЗВОДЫ ПО КАМНЮ» ниже.
uniform float rock_swirl = 1.6;
uniform float rock_veins = 0.55;
// Крупный слой у земли: пятна посуше и посырее, размером с крупную волну.
uniform float soil_patch = 0.45;
// РАЗНАЯ ГЛЯНЦЕВОСТЬ У ПОЛОС — решение пользователя: «было бы супер здорово,
// если бы эти разные полосы по-разному взаимодействовали со светом». У
// настоящей породы полосы — это разные минералы, и блестят они по-разному:
// кварцевая жила отсвечивает, а выветренный полевой шпат матовый.
// `rock_bands` — на сколько полос делим тон, когда раздаём им блеск. Число
// СВОЁ, не то, которым дробится цвет: блеск должен идти крупнее цвета, иначе
// он рассыпается в блёстки.
uniform float rock_bands = 6.0;
// На сколько полос дробится САМ рисунок породы — сверх общих ступеней тона.
// Полос от этого больше, и они тоньше: решение пользователя «немного больше
// полос, они чуть тоньше».
uniform float rock_steps = 13.0;
uniform float gloss_low = 0.93;                      // матовая полоса
uniform float gloss_high = 0.55;                     // блестящая
uniform float stone_override = -1.0;                 // >=0 — вместо UV.x

// =============================================================================
//  ПИКСЕЛЬ ЗЕМЛИ
//
//  Мох носит нарисованный образец точками в семь миллиметров, и вся заросль от
//  этого читается пиксельной. Поверхность же красится на лету, картинки у неё
//  нет вовсе, — значит, и дробить надо не картинку, а САМ РАСЧЁТ: цвет считается
//  не в точке кадра, а в середине клетки, на которую эта точка попала.
//
//  КЛЕТКА ЖИВЁТ В МИРЕ, А НЕ НА ЭКРАНЕ. Привяжи её к экрану — и пиксели поползут
//  по земле, стоит тронуть камеру: это сразу читается как грязь на стекле, а не
//  как рисунок. В мире клетка стоит на месте, и земля выглядит сложенной из
//  кубиков, как оно и задумано.
//
//  СНИЗУ ЕСТЬ РУБЕЖ. Издали клетка становится мельче экранной точки, и тогда это
//  уже не пиксель, а рябь: при малейшем движении камеры она закипает. Ниже
//  рубежа пиксель распускаем обратно в гладкий цвет — дробить мельче, чем видно,
//  всё равно не во что.
// =============================================================================
uniform float pixel = 0.03;                          // сторона клетки, м; 0 — выключить
uniform float pixel_steps = 6.0;                     // на сколько ступеней дробятся
                                                     // величины, приходящие с вершин

varying vec3 w_pos;
varying vec3 w_nrm;

// =============================================================================
//  СВОЙ ТОН У КАЖДОГО КАМНЯ
//
//  На снимках соседние валуны заметно разной светлоты: у одного лишайник взял
//  всю спину, другой почти голый, третий темнее от сырости. Это и есть первое,
//  по чему глаз отделяет камень от камня, — раньше самого силуэта.
//
//  Тон здесь считается по КРУПНОЙ ВОЛНЕ шума от места в мире (2.4 м). Для
//  земли это верно: тон гуляет по ней пятнами, и соседние места похожи. Но
//  отдельные глыбы лежат вплотную, попадают все в одно пятно и красятся
//  одинаково — грудой одинаковых камней, чего в природе не бывает.
//
//  Поэтому у каждого тела есть СВОЙ СДВИГ по этому шуму, приходящий с его
//  расстановкой. Внутри тела тон по-прежнему гуляет (камень не заливка), а
//  между телами теперь не совпадает. Земле и массиву сдвиг приходит нулевым:
//  у них своего смещения нет, и всё остаётся как было.
// =============================================================================
varying vec3 tone_off;


float hash13(vec3 p) {
	p = fract(p * vec3(0.1031, 0.1030, 0.0973));
	p += dot(p, p.yxz + 33.33);
	return fract((p.x + p.y) * p.z);
}


float vnoise(vec3 p) {
	vec3 i = floor(p);
	vec3 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	float n000 = hash13(i);
	float n100 = hash13(i + vec3(1.0, 0.0, 0.0));
	float n010 = hash13(i + vec3(0.0, 1.0, 0.0));
	float n110 = hash13(i + vec3(1.0, 1.0, 0.0));
	float n001 = hash13(i + vec3(0.0, 0.0, 1.0));
	float n101 = hash13(i + vec3(1.0, 0.0, 1.0));
	float n011 = hash13(i + vec3(0.0, 1.0, 1.0));
	float n111 = hash13(i + vec3(1.0, 1.0, 1.0));
	return mix(mix(mix(n000, n100, f.x), mix(n010, n110, f.x), f.y),
			   mix(mix(n001, n101, f.x), mix(n011, n111, f.x), f.y), f.z);
}


// ОКТАВУ МЕЛЬЧЕ КЛЕТКИ ПОКАЗАТЬ НЕЛЬЗЯ.
//
// Клетка берёт из такой октавы ОДНО число — какое придётся, — и соседние клетки
// берут числа, между собой никак не связанные. Вместо зерна выходит соль с
// перцем: у камня самый мелкий слой шума 2.8 см, а клетка 3 см, и вся глыба
// покрывалась рябью из отдельных точек.
//
// Гасим такую октаву — но не в ноль, а в её собственную середину: уйди она в
// ноль, вместе с зерном ушла бы и яркость, и порода потемнела бы вся разом.
// Гасим плавно, чтобы на отходе камеры ничего не щёлкало.
//
// РУБЕЖ НЕ ВДВОЕ, А ВПЯТЕРО. По счёту хватило бы двух клеток на волну — этого
// требует сама теорема о выборке. Но глазу двух мало: волна в две клетки видна
// не волной, а чередованием точек, и рябь остаётся рябью. Волна начинает
// читаться пятном примерно с пяти клеток, оттуда и берём.
float octave(vec3 p, float scale, float wave, float cell) {
	return mix(0.5, vnoise(p * scale),
		smoothstep(2.0, 5.0, wave / max(cell, 0.000001)));
}


float fbm_at(vec3 p, float scale, float cell) {
	float wave = 1.0 / scale;                        // длина волны первой октавы, м
	return octave(p, scale, wave, cell) * 0.57
		+ octave(p, scale * 2.07, wave / 2.07, cell) * 0.29
		+ octave(p, scale * 4.13, wave / 4.13, cell) * 0.14;
}


// ГЛАДКУЮ ВЕЛИЧИНУ — НА СТУПЕНИ.
//
// Дробления положения мало. Доля породы, впадина и толща приходят С ВЕРШИН и
// между ними тянутся гладко: сколько ни дроби положение, они останутся
// плавными — и поверх пиксельного цвета лягут мягкие разводы, а по ним ещё и
// ровные дуги от ступеней тона. Кубики при этом пропадают.
//
// ОКРУГЛЯЕМ ПРОСТО, БЕЗ РАЗБРОСА. Сперва к округлению подмешивалась добавка,
// своя у каждой клетки, — старый приём набора полутонов точками. По расчёту он
// верен: в среднем по многим клеткам выходит ровно то, что было. На кадре вышла
// рябь из отдельных точек по всей глыбе, и она же — половина того «пиксельного
// шума», на который жаловались. Границы и без разброса ломаются как надо: в них
// уже подмешан шум, а он теперь считается по клеткам.
float blocky(float v, float steps, float sharp) {
	return mix(v, floor(v * steps + 0.5) / steps, sharp);
}


void vertex() {
	w_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	w_nrm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
	// У обычной поверхности своих данных на тело нет, и здесь приходит ноль —
	// то есть земля и массив красятся ровно так же, как красились.
	tone_off = INSTANCE_CUSTOM.xyz;
}


void fragment() {
	vec3 n = normalize(w_nrm);

	// --- клетка --------------------------------------------------------------
	// Сколько метров приходится на экранную точку — по тому, насколько разъехалось
	// положение у соседних точек кадра. Клетка мельче двух таких — уже не пиксель,
	// а рябь; там пиксель распускаем.
	float screen_m = max(length(fwidth(w_pos)), 0.000001);
	float sharp = pixel > 0.0001
		? clamp(pixel / (screen_m * 2.0), 0.0, 1.0) : 0.0;
	float step_m = max(pixel, 0.0001);

	// КЛЕТКА ЛЕЖИТ ПО ПОВЕРХНОСТИ, А НЕ ВЫРЕЗАЕТСЯ КУБАМИ.
	//
	// ГРАБЛИ, свои же: сперва клетка была кубиком в мире, `floor(w_pos / pixel)`.
	// На плоской макушке и на отвесной стенке такой кубик и правда даёт квадрат,
	// а на любом КОСОМ склоне плоскость режет решётку кубов по треугольникам и
	// шестиугольникам — это школьное сечение куба, и оно же вылезло на холме.
	//
	// Теперь клетку кладём по той оси, куда смотрит земля: две доли берём с
	// поперечных осей и дробим их, а третью досчитываем так, чтобы точка осталась
	// на касательной плоскости. Квадрат остаётся квадратом, только вкось — как и
	// положено плитке на склоне.
	vec3 an = abs(n);
	vec3 ax_u = vec3(1.0, 0.0, 0.0);
	vec3 ax_v = vec3(0.0, 1.0, 0.0);
	if (an.y >= an.x && an.y >= an.z) {
		ax_u = vec3(1.0, 0.0, 0.0);
		ax_v = vec3(0.0, 0.0, 1.0);
	} else if (an.x >= an.z) {
		ax_u = vec3(0.0, 0.0, 1.0);
		ax_v = vec3(0.0, 1.0, 0.0);
	}
	// Третья ось — та самая, вдоль которой земля смотрит: на неё нормаль ложится
	// не меньше чем на 0.577, и делить на неё безопасно.
	vec3 ax_w = cross(ax_u, ax_v);
	float du = (floor(dot(w_pos, ax_u) / step_m) + 0.5) * step_m - dot(w_pos, ax_u);
	float dv = (floor(dot(w_pos, ax_v) / step_m) + 0.5) * step_m - dot(w_pos, ax_v);
	float dw = -(dot(n, ax_u) * du + dot(n, ax_v) * dv) / dot(n, ax_w);
	// Считаем цвет В СЕРЕДИНЕ КЛЕТКИ. Вблизи — ровно в середине, у рубежа — на
	// полпути к своей настоящей точке: так пиксель не пропадает разом.
	vec3 q_pos = w_pos + (ax_u * du + ax_v * dv + ax_w * dw) * sharp;
	// Клетка, которой считаем шум, — в метрах. Ноль значит «пикселя нет».
	float cell_m = step_m * sharp;

	// Долю породы подтягиваем к краям: усреднение по вершинам растягивало
	// переход земля/скала на целую ячейку, и граница выходила размытой.
	float raw_stone = stone_override >= 0.0 ? stone_override : clamp(UV.x, 0.0, 1.0);
	float cav = clamp(UV.y, 0.0, 1.0) * 2.0 - 1.0;   // больше нуля — впадина

	// КРУПНУЮ ВОЛНУ БЕРЁМ СО СДВИГОМ ТЕЛА, мелкие — нет. Тон и зарастание
	// принадлежат камню целиком, и им сдвиг нужен; зерно же и крупа — это
	// поверхность породы как таковой, она у всех камней одна.
	float big = fbm_at(q_pos + tone_off, 0.42, cell_m);
	float fine = fbm_at(q_pos, 2.60, cell_m);
	float grit = fbm_at(q_pos, 8.70, cell_m);

	// НАСКОЛЬКО РЕЗОК ЗДЕСЬ КРАЙ КАМНЯ. Ширина перехода не одна на всю глыбу, а
	// гуляет по ней: местами порода выходит из дёрна отчётливой кромкой, местами
	// тонет в нём. Ровная по всей длине граница — что широкая, что узкая —
	// одинаково выдаёт наклейку: у настоящего камня одна сторона врезана в
	// склон, другая занесена землёй.
	float crisp = smoothstep(0.34, 0.66, fbm_at(q_pos + tone_off + 15.4, 0.50, cell_m));
	// ГРАНИЦА ПОРОДЫ УЖЕ, ЧЕМ БЫЛА. Полоса перехода доходила до ±0.34 вокруг
	// половины — больше трети всей шкалы, и серое утекало в зелень длинной
	// растушёвкой: глыба читалась пятном на склоне, а не телом.
	//
	// НО СУЖАТЬ ПОЛОСУ БЕЗ ШУМА НЕЛЬЗЯ. Доля породы приходит С ВЕРШИН, между
	// ними её тянут линейно, и порог по такой величине идёт ПРЯМЫМ ОТРЕЗКОМ
	// поперёк каждого треугольника. Пока полоса была широкой, изломы прятались
	// в растушёвке; стоило её сузить — и край глыбы стал зубчатым по форме
	// сетки. Разгладить величину по соседям тут НЕ помогает: она и так гладкая,
	// зубцы даёт сам порог.
	//
	// Лечит шум мельче треугольника (у нас грани по 0.67 м, а шум 0.38 и
	// 0.11 м): порог начинает гулять ВНУТРИ треугольника, и граница выходит
	// неправильной, а не собранной из отрезков.
	//
	// Ширина по-прежнему гуляет по глыбе (`crisp`): местами порода выходит
	// кромкой, местами тонет в дёрне — ровная по всей длине граница одинаково
	// выдаёт наклейку, что широкая, что узкая.
	// Сила подобрана по делу, а не на глаз. Доля породы меняется примерно на
	// 0.35 поперёк одной грани, значит сдвиг границы на треть грани стоит около
	// 0.12 — столько и берём с запасом.
	//
	// САМЫЙ МЕЛКИЙ СЛОЙ (0.11 м) ЗДЕСЬ ОСТАВЛЕН по решению пользователя. Я
	// пробовал его убрать — он вшестеро мельче грани и по расчёту должен давать
	// не неправильность, а крупу. На кадре вышло хуже: без него край стал
	// мёртво-ровным. Расчёт про «дрожащие зёрна» глазом не подтвердился.
	// ШУМ УБАВЛЕН ВТРОЕ (2026-09-01, её кадр: «слишком грубый, квадратный край
	// земли по отношению к камню»).
	//
	// Число разошлось с собственным расчётом, записанным выше: там выведено, что
	// сдвиг границы на треть грани стоит около 0.12, — а стояло 0.75, вшестеро
	// больше. При такой силе граница гуляет НА ЦЕЛУЮ ГРАНЬ решётки (0.67 м) и
	// уже не облегает камень, а ходит вокруг него крупными зубцами. Пиксельная
	// клетка (3 см) режет эти зубцы на квадраты — отсюда и «квадратный край».
	//
	// Оба слоя оставлены: самый мелкий она однажды уже отстояла («без него край
	// стал мёртво-ровным»), убавлена только сила.
	float edge_jitter = (fine - 0.5) * 0.28 + (grit - 0.5) * 0.12;
	// ГРАНИЦА ПОРОДЫ ЕЩЁ РЕЗЧЕ — решение пользователя: «более чёткая граница
	// между зеленью земли и самим камнем». Была 0.22…0.08, стала 0.14…0.04.
	// Резать её без шума по-прежнему нельзя (порог по величине с вершин идёт
	// прямым отрезком поперёк треугольника), но шум для этого уже подмешан.
	float stone_band = mix(0.14, 0.04, crisp);
	// НА СТУПЕНИ ГОНИМ ГОТОВУЮ ДОЛЮ, а не то, из чего она считалась. Порогов над
	// нею три подряд, и раздроби мы их по отдельности — ступени одного попадали
	// бы в середину ступеней другого, а на кадре вышла бы каша из мелких обрезков
	// вместо ровных клеток.
	float stone = blocky(smoothstep(0.5 - stone_band, 0.5 + stone_band,
		raw_stone + edge_jitter), pixel_steps, sharp);

	// ТРЕЩИН ЗДЕСЬ НЕТ НАРОЧНО. Их убрали: настоящая расколотая глыба — это не
	// рисунок на гладком теле, а НЕСКОЛЬКО КАМНЕЙ, сложенных друг на друга, с
	// плоскими сколами и травой в стыках. Это работа по форме, а не по цвету,
	// и делать её надо отдельно. Швы, нарисованные поверх целого тела, только
	// притворялись ею.

	// --- голая порода --------------------------------------------------------
	// РЯБЬ РАСТЯГИВАЕМ, иначе гранит выходит бетоном. Шум `fbm` только на бумаге
	// ходит от нуля до единицы: замерено на сорока тысячах точек — один из ста
	// ниже 0.30, один из ста выше 0.70, а половина точек и вовсе лежит между
	// 0.41 и 0.59. Смесь двух шумов сужает размах ещё сильнее, и порода красилась
	// в 0.33…0.44 вместо задуманных 0.24…0.53 — меньше сорока процентов
	// заказанного. Оттого камень и читался ровной серой заливкой без структуры.
	//
	// Пределы взяты по замеру, а не на глаз: 0.30 и 0.70 — это и есть тот самый
	// один из ста с каждого конца.
	// ТОН БЕРЁТ КРУПНАЯ ВОЛНА, ЗЕРНО ОСТАЁТСЯ СЛАБЫМ. Растянуть надо было
	// размах, а не резкость: когда я растянул смесь мелких шумов (0.38 м и
	// 0.11 м), гранит покрылся частой пятнистой рябью — камуфляж, а не порода.
	// У настоящего гранита тон гуляет крупными пятнами в метры, а мелкое зерно
	// едва заметно и цвета почти не меняет.
	// ЗЕРНО ДЕРЖИМ СЛАБЫМ, НО НЕ УБИРАЕМ. Оно меняет тон на полпроцента — само
	// по себе неразличимо, — но ниже стоят двадцать ступеней тона, и у границы
	// ступени точка от малейшей примеси перескакивает в соседнюю: рябь
	// проявляется крупой по краям тоновых пятен. Я по этому расчёту зерно убрал,
	// и на кадре стало ХУЖЕ — порода вышла мёртвой заливкой. Возвращено по
	// решению пользователя: ступени проявляют зерно, и это оказалось нужно.
	// РАЗВОДЫ ПО КАМНЮ — то, что пользователю понравилось на кадре и что просили
	// усилить. Разводы эти не нарисованы и не наложены картинкой: их делают две
	// вещи ВМЕСТЕ.
	//
	//   1) крупная волна шума даёт плавное пятно от тёмного к светлому;
	//   2) весь цвет ниже загоняется в двадцать СТУПЕНЕЙ ТОНА — и плавное пятно
	//      разваливается на полосы с резкими краями, как горизонтали на
	//      топоплане. Клетка в 3 см рвёт края этих полос.
	//
	// Значит, чтобы разводов стало больше, надо дать ступеням больше плавного
	// материала — и увести его от круглых клякс.
	//
	// ВЕДЁМ КООРДИНАТУ ШУМОМ («разводим тесто»). Круглые кляксы дают круглые же
	// кольца — годится для лишайника, но не для породы. Стоит СДВИНУТЬ саму
	// точку, из которой берётся крупная волна, на величину другого шума, и
	// кольца вытягиваются, заворачиваются и начинают течь: получаются жилы и
	// слоистые разводы, как на настоящем камне. Это старый приём и он почти
	// ничего не стоит — один лишний вызов шума.
	vec3 swirl = q_pos + vec3(
		fbm_at(q_pos + 41.3, 0.30, cell_m) - 0.5,
		fbm_at(q_pos + 77.1, 0.30, cell_m) - 0.5,
		fbm_at(q_pos + 13.7, 0.30, cell_m) - 0.5) * rock_swirl;
	float veins = fbm_at(swirl, 0.62, cell_m);
	// СРЕДНЯЯ ВОЛНА — второй слой полос, вчетверо мельче крупной. Одна волна
	// даёт одно семейство горизонталей; две разной крупности накладываются, и
	// рисунок перестаёт читаться повтором.
	float mid = fbm_at(swirl, 1.15, cell_m);
	float tone = smoothstep(0.32, 0.68, big);
	float grain = (fine - 0.5) * 0.30 + (grit - 0.5) * 0.16;
	// ТРЕТИЙ СЛОЙ ЖИЛ, ещё вдвое мельче. Просили «немного больше полос, они чуть
	// тоньше»: полосу рождает не сам шум, а ступень тона, поперёк которой этот
	// шум идёт. Добавь слой помельче — и на той же площади ступеней окажется
	// больше, а каждая станет уже.
	float fine_vein = fbm_at(swirl, 2.30, cell_m);
	float mottle = clamp(0.15 + 0.70 * tone
		+ (veins - 0.5) * rock_veins
		+ (mid - 0.5) * rock_veins * 0.45
		+ (fine_vein - 0.5) * rock_veins * 0.26 + grain, 0.0, 1.0);
	// И ДРОБИМ САМ РИСУНОК, не дожидаясь общих ступеней тона. Те идут по готовому
	// цвету и одни на весь мир — землю они дробят наравне с камнем. Здесь же
	// ступени СВОИ, только у породы, и оттого полос на ней заметно больше.
	if (rock_steps > 0.5) {
		mottle = floor(mottle * rock_steps + 0.5) / rock_steps;
	}
	vec3 rock = mix(rock_dark, rock_light, mottle);
	// ЗЕМЛЕ — СВОЙ КРУПНЫЙ СЛОЙ. Она красилась одной мелочью (0.38 и 0.11 м), и
	// оттого выходила ровным ковром: у неё не было ничего крупнее ладони.
	// Крупная волна даёт то, что видно на любом лугу, — пятна посуше и посырее.
	float soil_tone = clamp(fine * 0.55 + grit * 0.25 + (big - 0.5) * soil_patch
		+ 0.2, 0.0, 1.0);
	vec3 soil = mix(soil_dark, soil_light, soil_tone);
	vec3 bare = mix(soil, rock, stone);

	// --- зелёный покров ------------------------------------------------------
	float lean = n.y + (big - 0.5) * mantle_rough + (fine - 0.5) * mantle_rough * 0.45;
	lean -= smoothstep(0.76, 1.0, fine) * bald;      // вытоптанные проплешины

	// КАМЕНЬ ПО УМОЛЧАНИЮ ГОЛЫЙ. Зелень пускаем на него только тремя путями:
	//   в складки — там копится занесённая земля;
	//   местами у подножия глыба слегка тонет в дёрне;
	//   целиком зарастают нижние и затенённые глыбы.
	// Сырость сюда позже добавится четвёртым слагаемым.
	// Складку СБИВАЕМ ШУМОМ, прежде чем гнать в порог. Величина приходит с
	// вершин сетки и между соседями меняется ступенькой; порог превращает такую
	// ступеньку в прямую линию поперёк треугольника, и на камне вылезают резкие
	// зелёные клинья по форме сетки. Сама величина уже разглажена по соседям,
	// а шум добавляет краю неправильность — чтобы он не шёл по рёбрам.
	// ШУМ ЗДЕСЬ БЫЛ СИЛЬНЕЕ САМОГО СИГНАЛА. Пока впадина считалась разницей со
	// средним по соседям, она упиралась в потолок ±1 просто от разброса семян,
	// и подмешанные ±0.26 были мелкой поправкой на краю. Теперь мерка честная и
	// оттого мелкая: на камне девять из десяти ячеек не выше 0.37. Прежний шум
	// перекрывал её целиком — и затенение щелей рисовало не швы, а пятна
	// камуфляжа размером с сам шум (2.4 м, ровно те тёмные кляксы на глыбе).
	// ЕСТЬ ЛИ ПОД ТОЧКОЙ ЗЕМЛЯ. Приходит с сетки: 0 — под ней пусто, 1 —
	// сплошная толща на четыре ячейки вниз.
	// ТОЛЩУ ПОД ТОЧКОЙ ТОЖЕ СБИВАЕМ ШУМОМ.
	//
	// ГРАБЛИ, свои же и уже записанные — только в прошлый раз они вылезли на
	// доле породы, а теперь на толще. Кадр пользователя: «треугольные и
	// квадратные одиночные пятна зелени на скале».
	//
	// Толща приходит С ВЕРШИН и между ними тянется линейно. Порог по такой
	// величине идёт ПРЯМЫМ ОТРЕЗКОМ поперёк каждого треугольника — и там, где
	// толща у соседних семян разная (а у камня с ямами она разная сплошь),
	// зелень включается ровно по грани сетки. Отсюда ромбы и клинья: это не
	// пятна мха, это отдельные треугольники решётки.
	//
	// У впадины шум подмешан давно и по той же причине, а у толщи его не было
	// вовсе. Лечится тем же: порог начинает гулять ВНУТРИ треугольника, и край
	// выходит неправильным, а не собранным из отрезков.
	// И САМОЙ ТОЛЩЕ ДАЁМ ПОЛ НА ТОМ, ЧТО СМОТРИТ ВВЕРХ.
	//
	// Толща считается столбиком вниз и у обрыва прыгает на три четверти между
	// соседями — разгладить её нельзя, это не шум, а настоящая форма. Но её
	// СМЫСЛ («есть ли куда осесть наносу») на пологом месте выполняется и без
	// столбика: на то, что смотрит вверх, наносит всегда. Потолок пещеры и
	// нависающий край остаются ни с чем, как и задумано, а размах падает вдвое.
	// ТОЛЩУ ПОД ТОЧКОЙ ИЗ РЕШЕНИЯ О ЗЕЛЕНИ УБРАЛИ СОВСЕМ.
	//
	// Она приходит с вершин и у обрыва честно прыгает на три четверти между
	// соседними семенами: у одной ячейки под ней три слоя земли, у соседки ни
	// одного. Порог по такой величине идёт ПРЯМЫМ ОТРЕЗКОМ поперёк
	// треугольника — отсюда треугольные выносы травы на камне.
	//
	// Смягчить не вышло, и я пробовал трижды: шум в шейдере (±0.15 против
	// скачка 0.75), сглаживание по соседям в сетке (два прохода довели 0.75
	// лишь до 0.536), пол по нормали. Ступень шумом не перебить и усреднением
	// семи точек не убрать — это не шум, а настоящая форма.
	//
	// ЗАМЕНЯЕМ ЕЁ ТЕМ, ЧТО ГЛАДКО ПО ПОСТРОЕНИЮ, — наклоном самой поверхности.
	// Смысл у толщи был «есть ли куда осесть наносу», и нормаль отвечает на это
	// не хуже: на то, что смотрит вверх, наносит всегда; потолок пещеры и
	// нависающий край смотрят вниз и остаются ни с чем. Стенка ямы смотрит
	// вбок — ей тоже ничего, и это верно.
	float rest = clamp(smoothstep(-0.10, 0.60, n.y)
		+ (fine - 0.5) * 0.30 + (grit - 0.5) * 0.12, 0.0, 1.0);
	float cav_r = cav + (fine - 0.5) * 0.10 + (big - 0.5) * 0.07;
	// ПОРОГИ ПОДОГНАНЫ ПОД ЗАМЕРЕННЫЙ РАЗМАХ. На камне впадина: середина 0.01…
	// 0.10, девять из десяти 0.25…0.37, наибольшая 0.65. Прежние пороги ждали
	// 0.46 и 0.60 — до них сигнал не доходил почти нигде, и зелень в трещинах с
	// зарастанием молча не включались ни разу.
	//
	// Выше 0.65 впадина не поднимется НИКАКИМ способом: щель уже ячейки решётка
	// не держит. Проверено — ни жёсткое объединение глыб, ни подрезка шва
	// сигнала не прибавляют (0.37 против 0.35 у обычного сложения).
	float crack = smoothstep(0.12, 0.36, cav_r);
	// НИЖНИЕ ГЛЫБЫ ЗАРАСТАЮТ — но «низко» само по себе ничего не значит.
	// Правило писалось для валуна, лежащего у подножия склона, а высота — это
	// всё, что оно проверяло. Стоит выкопать яму, и низкими становятся стенка
	// ямы, нависающий край и потолок пещеры: земля им доставалась ни за что.
	// Теперь спрашиваем, есть ли под точкой земля.
	// «НИЗКО» ПЕРЕСТАЛО ЗНАЧИТЬ «ВАЛУН В ТРАВЕ». Правило писалось для камня,
	// лежащего в лугу: он тонет в дёрне и зарастает. Меряло оно высоту ПО МИРУ —
	// и это работало, пока камни были низкими. Скалы стартовой сцены поднялись
	// до 5.6 м, и «низкой» стала их ПОДОШВА: дёрн полез вверх по обрыву.
	//
	// Кадр пользователя: «необоснованные треугольные выносы травы на камень» —
	// это они и есть. Отличить валун от подножия обрыва здесь нечем: высоты
	// окрестной земли у точки кадра нет. Поэтому правило не чиним, а УБАВЛЯЕМ
	// втрое: валун в траве по-прежнему подзарастает, а на обрыв дёрну уже не
	// хватает.
	float low = (1.0 - smoothstep(-1.5, 2.2, q_pos.y)) * rest;
	float shade = smoothstep(0.02, 0.28, cav_r);
	float overgrown = clamp(low * 0.25 + shade * 0.55, 0.0, 1.0);
	// УТОПАНИЕ В ДЁРНЕ — туда же. Глыба не может быть утоплена в земле, если
	// под ней земли нет: то, что снизу пусто, ничем не заносится.
	float sink = smoothstep(0.48, 0.82, big) * 0.30 * rest;
	float bare_edge = mantle_stone - crack * moss_crack - overgrown * moss_damp - sink;
	float edge = mix(mantle_soil, bare_edge, stone);
	// Та же гуляющая резкость, что и у доли породы: где камень выходит кромкой,
	// там и дёрн обрывается коротко.
	// ПОЛОСА ПЕРЕХОДА ДЁРНА ВЕРНУЛАСЬ к 0.28…0.09. Сузил её я сам, заодно с
	// границей ПОРОДЫ, — а просили чёткости именно у границы породы, и это
	// другое число (`stone_band`, оно и осталось узким). Узкая полоса здесь
	// превращает всякое дрожание в резкую линию, а дрожит толща под точкой: у
	// обрыва она честно меняется на три четверти между соседними семенами.
	// Отсюда и треугольные выносы травы на камне.
	// А НА КАМНЕ ПОЛОСА ПЕРЕХОДА ШИРОКАЯ, И ЭТО ВТОРАЯ ПОЛОВИНА ЛЕЧЕНИЯ.
	//
	// Треугольники делает не только само правило, но и РЕЗКОСТЬ его края. Дёрн
	// включается порогом по наклону поверхности, а у гранёного камня наклон
	// скачет от грани к грани — порог и щёлкает целыми гранями, выдавая
	// треугольники решётки.
	//
	// На земле узкая полоса нужна: там край дёрна должен быть кромкой. На камне
	// не нужна вовсе — зелень на нём и в природе сходит на нет пятном, а не
	// линией. Широкая полоса гасит щелчок: грани не включаются целиком, а
	// проступают постепенно.
	float band = mix(mix(0.28, 0.09, crisp), 0.40, stone);
	float m = blocky(smoothstep(edge - band, edge + band * 1.3, lean),
		pixel_steps, sharp);

	// Пестроту набираем из трёх масштабов сразу, иначе выходят пятна камуфляжа.
	float v = big * 0.46 + fine * 0.38 + grit * 0.16;
	vec3 turf = mix(turf_deep, turf_lit, smoothstep(0.26, 0.74, v));
	turf = mix(turf, turf_dry, smoothstep(0.62, 0.95, grit) * 0.28);

	vec3 col = mix(bare, turf, m);
	// По самому краю дёрна просвечивает земля — тонкая тёмная каёмка.
	//
	// НА КАМНЕ ОНА НЕ ТОНКАЯ. Ширина каёмки — это ширина полосы перехода, а на
	// камне полоса нарочно широкая (0.40 против 0.09), чтобы грани решётки не
	// щёлкали целиком. Тонкая чёрточка на земле оборачивалась на камне широкой
	// тёмной размазнёй у самой подошвы — третьей причиной тёмного перехода
	// (кадр 2026-09-01). Сила убавлена там, где полоса широка.
	col = mix(col, soil_dark, m * (1.0 - m) * 4.0 * mix(0.30, 0.10, stone));

	// --- щели ----------------------------------------------------------------
	// Затемнение сдержанное: при мелкой ячейке складок стало вдесятеро больше,
	// и прежняя сила превращала каждую из них в чёрную дыру.
	// ФОРМУ ЛЕПИТ КРИВИЗНА, В ОБЕ СТОРОНЫ. Прежде щели только темнели, а выступы
	// не делали ничего — и светлыми они казались лишь по сравнению с
	// затенённым вокруг. Пользователю это понравилось само по себе: «создаёт
	// объём и подчёркивает форму». Значит, надо не намекать, а делать: щель
	// темнее, выступ светлее.
	//
	// Пороги по замеру на глыбе, а не на глаз. Впадина там ходит так:
	//   выступы  — до −0.86, один из десяти ниже −0.43…−0.64;
	//   середина — около нуля;
	//   щели     — один из десяти выше 0.32…0.40, наибольшее 0.55.
	// У выступов размах БОЛЬШЕ, чем у щелей, оттого и пороги у них дальше.
	float hollow = blocky(smoothstep(0.08, 0.34, cav_r) * cavity_dark,
		pixel_steps, sharp);
	float ridge = blocky(smoothstep(-0.10, -0.55, cav_r) * cavity_dark,
		pixel_steps, sharp);
	// НАСТОЯЩАЯ ТРЕЩИНА — ЭТО ЧЁРНАЯ ЧЕРТА, А НЕ ПРИТЕНЕНИЕ.
	//
	// Складку и трещину нельзя красить одним порогом. Складка — мелкая, её и
	// притенить надо чуть; трещина же уходит в тело на метр, и свет туда не
	// доходит вовсе. Пока обе шли через один `hollow` с потолком в 0.55, щели
	// выходили серыми — а на снимках они чёрные, и именно черта, а не серость,
	// разделяет камни глазом.
	//
	// Порог взят по замеру: на массиве впадина в трещинах доходит до 0.77, а
	// девять из десяти мест лежат ниже 0.49. Значит, 0.38…0.72 — это ровно
	// трещины и ничего кроме них.
	// Порог подогнан под замер: впадина в широких трещинах доходит до 0.70, а
	// девять из десяти мест лежат ниже 0.42. Прежние 0.38…0.72 до верха не
	// доставали.
	//
	// Подгонялся он под ОСКОЛКИ на дне трещины, а их потом убрали. Сам порог
	// остался в деле: по нему идёт глубокое затенение щели ниже и мокрый блеск
	// на её дне.
	float slot = blocky(smoothstep(0.30, 0.60, cav_r) * cavity_dark * stone,
		pixel_steps, sharp);
	// ЗАТЕНЕНИЕ ЩЕЛИ СПРАШИВАЕТ ПОРОДУ (кадр 2026-09-01: «слишком тёмный
	// переход между камнем и землёй»).
	//
	// Стык камня с землёй ВОГНУТ по построению, и впадина там высока — а щель
	// шла по одной впадине, про породу не спрашивая. Замер у подошвы: из мест
	// БЕЗ породы 37.5% переваливали порог складки и 12.5% — порог щели, то есть
	// каждое восьмое место травы темнело втрое. На кадре это тёмные пятна по
	// границе, а не кайма: 12.5% — доля, а не полоса.
	//
	// Трава не трескается: `slot` домножен на `stone` и на земле выключен
	// начисто. Складке на земле оставлена треть силы — рельеф она подчёркивает,
	// а тёмных пятен уже не даёт.
	//
	// Это ТЕ ЖЕ ГРАБЛИ, что записаны ниже про осколки: всё, что касается камня,
	// обязано спрашивать `stone`. Второй раз в том же шейдере.
	col *= mix(1.0, mix(0.85, 0.55, stone), hollow);
	col *= mix(1.0, 0.34, slot);
	col *= mix(1.0, 1.28, ridge);

	// ТРЕЩИНЫ ЗДЕСЬ НЕ РИСУЮТСЯ ВОВСЕ.
	//
	// Кадр пользователя: «нет, трещины не должны быть тёмными полосами. Они
	// должны быть полностью материальными».
	//
	// Рисованная часть — тонкая черта по плоскостям и ветвящаяся сеть по
	// гребням шума — УБРАНА целиком. Она была честной попыткой обойти предел
	// решётки, но на кадре читалась ровно тем, чем и была: тёмными полосами,
	// нанесёнными поверх камня. Трещину теперь делает только ФОРМА — см.
	// `_joints` в `SpaceGrid.gd`.
	//
	// Тут же лежала и моя ошибка, и её стоит помнить: осколки рисовались всюду,
	// где есть впадина, а про породу их спросить я забыл — тёмные разводы легли
	// на ТРАВУ у подошвы глыбы. Сами осколки потом убрали, а правило осталось:
	// всё, что касается камня, обязано спрашивать `stone`.

	// ТЁМНЫХ ТРЕЩИН НЕТ. Убраны по кадру: «убери эти тёмные трещины вообще».
	//
	// Их пробовали трижды, и каждый раз выходило хуже кадром, чем по числам:
	// тонкая черта по плоскостям, ветвящаяся сеть по гребням шума, тень по
	// настоящей глубине ямы. Последняя была честнее всех — тень бралась из
	// самой формы, а не рисовалась поверх, — и всё равно читалась тёмными
	// пятнами на камне.
	//
	// ЧТО ИЗ ЭТОГО СЛЕДУЕТ. Порода при шаге решётки в 0.67 м не умеет трескаться
	// так, чтобы это шло ей на пользу: раскрыв щели держит решётка, а всё, чем
	// его пробовали обойти, обходится краской — и краска себя выдаёт. Форма
	// трещин в поле осталась (она даёт углубления и ничему не мешает), а
	// затенения по ним больше нет.
	// ОСКОЛКИ УБРАНЫ. Ячейки Вороного на дне широкой трещины давали ровно то,
	// что пользователь и назвала: «сетчатую текстуру». Задумывались они как
	// щебень, а читались растрескавшейся глиной поверх камня — рисунком, а не
	// поверхностью. Тот же урок, что и с рисованной чертой: то, чего решётка не
	// держит, нельзя подменить узором.

	// --- стилизация ----------------------------------------------------------
	// Ступеньки тона: картинка становится ближе к рисованной, а пласты
	// читаются слоями, а не размазанным градиентом.
	// СТУПЕНИ СЧИТАЕМ В ГАММЕ, не в линейном цвете. В линейном тёмные тона
	// сжаты к нулю, и каждый канал округляется по-своему — тёмно-серый
	// вылетает то в розовый, то в чёрный. Именно так и было.
	if (posterize > 0.5) {
		vec3 g = pow(max(col, vec3(0.0)), vec3(1.0 / 2.2));
		g = floor(g * posterize + 0.5) / posterize;
		col = pow(g, vec3(2.2));
	}

	ALBEDO = col;

	// СВЕТ ПО ПОЛОСАМ. Полоса — это ступень тона, то есть ровно то, что глаз и
	// читает разводом. Даём каждой свою глянцевость, и разводы начинают
	// проявляться не только цветом, но и бликом: повернул камеру — рисунок
	// ожил. Одним цветом такого не сделать никаким усилением.
	//
	// НОМЕР ПОЛОСЫ БЕРЁМ ОТ ТОНА, А НЕ ОТ ШУМА. Возьми мы шум, блеск пошёл бы
	// своим рисунком поверх цветного, и вышло бы два спорящих узора вместо
	// одного. От тона — блеск ложится ровно по тем же полосам, что видны.
	float tone_band = floor(mottle * rock_bands) / max(rock_bands, 1.0);
	// Своя доля у полосы, но не случайная от точки к точке: одна на всю полосу.
	float shine = fract(sin(tone_band * 78.233 + 12.9898) * 43758.5453);
	float rock_rough = mix(gloss_low, gloss_high, shine);
	// Блестящая полоса и отсвечивает сильнее: у одной шероховатости блик выходит
	// вялым, потому что зеркальность у всей породы одна.
	float rock_spec = mix(0.10, 0.45, shine);
	// Мокрое дно трещины блестит: туда стекает и там держится вода.
	rock_rough = mix(rock_rough, 0.42, slot * 0.7);
	// Земля и дёрн — матовые, у них полос нет.
	float dry_rough = mix(0.97, rock_rough, stone);
	ROUGHNESS = mix(dry_rough, 0.92, m);
	SPECULAR = mix(mix(0.16, rock_spec, stone), 0.12, m);
}
