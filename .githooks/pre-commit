#!/bin/sh
# Номер сборки в углу экрана: каждый коммит — свой номер.
#
# Номер это ЧИСЛО КОММИТОВ, и берётся оно здесь, а не в игре: собранная демка
# про git ничего не знает, а `Version.gd` уезжает в неё вместе с кодом.
#
# ПЕРЕПИСАННЫЙ КОММИТ (`--amend`) от обычного не отличить: до создания коммита
# состояние у них одно и то же. Поэтому номер не только считается, но и
# СРАВНИВАЕТСЯ С ПРЕЖНИМ — берём больший из двух. Переписанный коммит получает
# новый номер, номера не повторяются, и разъехаться с историей нельзя.
#
# Обойти сознательно: SKIP_VERSION=1 git commit

[ "$SKIP_VERSION" = "1" ] && exit 0

root="$(git rev-parse --show-toplevel)"
file="$root/Version.gd"

count="$(git rev-list --count HEAD 2>/dev/null || echo 0)"
number=$((count + 1))

# Что записано в этом файле у последнего коммита.
prev="$(git show HEAD:Version.gd 2>/dev/null | sed -n 's/^const NUMBER: int = \([0-9]\{1,\}\).*/\1/p')"
if [ -n "$prev" ] && [ "$((prev + 1))" -gt "$number" ]; then
	number=$((prev + 1))
fi

cat >"$file" <<GD
extends RefCounted
# НОМЕР СБОРКИ. Файл пишет хук \`.githooks/pre-commit\` перед каждым коммитом —
# руками не править, правка потеряется на следующем же коммите.

const NUMBER: int = $number
const DATE: String = "$(date +%d.%m.%Y)"
GD

git add "$file"
exit 0
